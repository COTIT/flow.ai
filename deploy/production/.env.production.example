# Copy to deploy/production/.env.production on the VPS (chmod 600). Never commit the copy.
# Every variable docker-compose.production.yml reads. No secrets here: they are files in secrets/.

# --- The existing Traefik (v3.6, read on the VPS 2026-11-01) ---
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=le

# --- Build/version (required) ---
# Image tag: the main commit being deployed (git rev-parse --short HEAD).
GENESY_REF=

# --- Mail (required) ---
# Sender on every mail. The SMTP server itself is the secret file secrets/smtp_url.
MAIL_FROM=Genesy <no-reply@genesy.app>

# --- Optional ---
# Folder holding db_password, database_url, credentials_key, smtp_url (relative to deploy/production/).
SECRETS_DIR=./secrets
# API log filter.
RUST_LOG=genesy_360_api=info,tower_http=info
# Shop storefront app key (scope catalog:read), made in the office. Empty = shop answers 503.
STOREFRONT_APP_KEY=
# File storage origin for shop image CSP. Empty while there is no uploads bucket.
FILES_ORIGIN=
