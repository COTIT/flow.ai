# Copy to deploy/staging/.env.staging on the VPS (chmod 600). Never commit the copy.
# Every variable docker-compose.staging.yml reads. No real values here.

# --- Required: the existing Traefik (ask before the first deploy; no defaults on purpose) ---
# Docker network Traefik watches, e.g. from `docker inspect control360-traefik-traefik-1`.
TRAEFIK_NETWORK=
# HTTPS entrypoint name in Traefik's static config. Guess: websecure
TRAEFIK_ENTRYPOINT=
# ACME (Let's Encrypt) resolver name in Traefik's static config. Guess: letsencrypt
TRAEFIK_CERTRESOLVER=

# --- Build/version ---
# Image tag: the main commit being deployed (git rev-parse --short HEAD).
GENESY_REF=

# --- Optional ---
# Comma-separated CIDRs allowed in (Traefik ipAllowList). Empty = open to everyone.
STAGING_IP_ALLOWLIST=
# Folder holding db_password, database_url, credentials_key (relative to deploy/staging/).
SECRETS_DIR=./secrets
# VPS loopback port for the Mailpit inbox UI (reach it through an ssh tunnel).
MAILPIT_UI_PORT=18025
# API log filter.
RUST_LOG=genesy_360_api=info,tower_http=info
# Shop storefront app key (scope catalog:read), made in the staging office. Empty = shop answers 503.
STOREFRONT_APP_KEY=
# File storage origin for shop image CSP. Empty on staging (no uploads bucket).
FILES_ORIGIN=
