{
  "name": "@genesy/api-client",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "orval --config orval.config.ts",
    "generate:check": "orval --config orval.config.ts && git diff --exit-code -- src/generated && test -z \"$(git ls-files --others --exclude-standard -- src/generated)\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "axios": "^1.21.0",
    "zustand": "^5.0.16"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@genesy/eslint-config": "workspace:*",
    "@genesy/typescript-config": "workspace:*",
    "@types/react": "^19",
    "eslint": "^10",
    "orval": "8.42.0",
    "react": "19.3.1",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "exports": {
    "./client": "./src/client.ts",
    "./mutator": "./src/mutator.ts",
    "./query-provider": "./src/query-provider.tsx",
    "./model": "./src/generated/model/index.ts",
    "./endpoints/*": "./src/generated/*/*.ts",
    "./session": "./src/session.ts",
    "./pending": "./src/pending.ts",
    "./auth": "./src/auth.ts",
    "./setup": "./src/setup.ts"
  }
}
