{
  "name": "@genesy/e2e",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "e2e": "playwright test",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --test stack/*.test.mjs",
    "stack:up": "node stack/up.mjs",
    "stack:down": "node stack/down.mjs",
    "stack:reset": "node stack/reset.mjs",
    "stack:test": "node stack/test.mjs"
  },
  "devDependencies": {
    "@genesy/eslint-config": "workspace:*",
    "@genesy/typescript-config": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "^20",
    "eslint": "^10",
    "typescript": "^5"
  },
  "exports": {
    "./test": "./src/test.ts",
    "./projects": "./src/projects.ts",
    "./session": "./src/session.ts",
    "./api-mock": "./src/api-mock.ts"
  }
}
