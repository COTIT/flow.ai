    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "next": "^16"
  },
  "devDependencies": {
