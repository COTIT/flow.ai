# Copy to .env.local
# Backend address for server code and the /v1 forward (the browser always calls /v1).
API_URL=http://localhost:8080/v1
# Public address of this shop, for canonical links and social previews.
SITE_URL=http://localhost:3000
# Set to 1 on staging to suppress search indexing.
NOINDEX=
# Storefront app key (scope catalog:read), made in the office under app keys.
# Server-only secret: never prefix it with NEXT_PUBLIC_.
STOREFRONT_APP_KEY=
# Opt in to published home-page designs; unpublished workspaces keep the existing home.
SHOP_DESIGN_ENABLED=false
# File storage origin (scheme + host[:port]) serving signed images, e.g. the B2 endpoint.
# Allowed by CSP img-src and the public product image route. Leave empty without file storage.
FILES_ORIGIN=
