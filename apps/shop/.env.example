# Copy to .env.local
# Backend address for server code and the /v1 forward (the browser always calls /v1).
API_URL=http://localhost:8080/v1
# Public address of this shop, for canonical links and social previews.
SITE_URL=http://localhost:3000
# Storefront app key (scope catalog:read), made in the office under app keys.
# Server-only secret: never prefix it with NEXT_PUBLIC_.
STOREFRONT_APP_KEY=
# File storage origin (scheme + host[:port]) serving signed passport images, e.g. the B2 endpoint.
# Added to the CSP img-src; leave empty when the API has no file storage.
FILES_ORIGIN=
