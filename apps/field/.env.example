# Copy to `.env.local`. Only VITE_* values reach the browser bundle.
# Transitional (step 1 of the Genesy port): the app still reads Supabase until
# its data layer moves to the Genesy API. Unit tests set their own placeholders.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Drives the demo banner.
VITE_DATA_MODE=demo
# Release flag for equipment, loans, requests and the ops catalogue ("on" shows them).
VITE_FEATURE_RESOURCES=on
