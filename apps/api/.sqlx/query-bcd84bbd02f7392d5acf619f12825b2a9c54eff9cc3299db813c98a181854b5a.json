{
  "db_name": "PostgreSQL",
  "query": "SELECT l.id, l.code, l.public_code, p.name AS product_name\n           FROM lots l JOIN products p ON p.workspace_id = l.workspace_id AND p.id = l.product_id\n           WHERE l.workspace_id = $1 AND (l.code ILIKE $2 OR l.public_code ILIKE $2)\n           ORDER BY l.created_at DESC, l.id DESC LIMIT $3",
