{
  "db_name": "PostgreSQL",
  "query": "SELECT l.id AS link_id,l.revision_id,l.created_at,l.created_by,l.expires_at,l.revoked_at,CASE WHEN l.revoked_at IS NOT NULL THEN 'revoked' WHEN l.expires_at<=now() THEN 'expired' WHEN p.draft_revision_id IS DISTINCT FROM l.revision_id OR p.published_revision_id IS NOT DISTINCT FROM l.revision_id THEN 'ended' ELSE 'active' END AS \"status!\" FROM storefront_preview_links l JOIN storefront_pages p ON p.workspace_id=l.workspace_id AND p.id=l.page_id WHERE l.workspace_id=$1 AND l.revision_id=$2 ORDER BY l.created_at DESC,l.id DESC LIMIT 50",
