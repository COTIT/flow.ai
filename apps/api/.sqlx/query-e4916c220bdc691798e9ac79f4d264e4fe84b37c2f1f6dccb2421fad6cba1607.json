{
  "db_name": "PostgreSQL",
  "query": "SELECT l.id, l.code, l.name_en, l.name_sw, l.description_en, l.description_sw,\n                  l.indicative_min_minor, l.indicative_max_minor, l.currency_id,\n                  c.asset_type AS currency, c.decimals, l.is_active, l.created_at, l.updated_at\n           FROM farm_loan_products l JOIN currencies c ON c.id = l.currency_id\n           WHERE l.workspace_id = $1 AND ($2::uuid IS NULL OR l.id = $2)\n             AND ($3::bool IS NULL OR l.is_active = $3)\n           ORDER BY l.name_en, l.id LIMIT $4 OFFSET $5",
