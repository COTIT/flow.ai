  "query": "SELECT v.currency_id, upper(c.asset_type) AS \"code!\", c.decimals\n           FROM cash_vaults v\n           JOIN currencies c ON c.workspace_id = v.workspace_id AND c.id = v.currency_id\n           WHERE v.workspace_id = $1 AND v.id = $2 FOR NO KEY UPDATE OF v",
