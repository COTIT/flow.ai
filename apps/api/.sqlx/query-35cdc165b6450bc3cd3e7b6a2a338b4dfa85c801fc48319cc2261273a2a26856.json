  "query": "SELECT id, name, purchase_code, revenue_code, meta, created_at, updated_at,\n                  count(*) OVER () AS \"total!\"\n           FROM sales_groups\n           WHERE workspace_id = $1 AND deleted_at IS NULL\n             AND ($2::text IS NULL OR name ILIKE $2)\n           ORDER BY id\n           LIMIT $3 OFFSET $4",
