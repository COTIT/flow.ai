  "query": "SELECT m.team_id, u.id, u.first_name, u.middle_name, u.last_name, u.email\n         FROM team_members m\n         JOIN users u ON u.id = m.user_id AND u.deleted_at IS NULL\n         WHERE m.team_id = ANY($1)\n         ORDER BY m.team_id, m.created_at, u.id",
