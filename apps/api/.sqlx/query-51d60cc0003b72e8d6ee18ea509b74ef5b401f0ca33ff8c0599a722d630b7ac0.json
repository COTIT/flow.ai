{
  "db_name": "PostgreSQL",
  "query": "SELECT id, parent_id, name, description, meta, created_at, updated_at,\n                  count(*) OVER () AS \"total!\", (SELECT count(*) FROM products p\n              WHERE p.workspace_id = c.workspace_id AND p.category_id = c.id\n                AND p.deleted_at IS NULL) AS \"products_count!\" FROM product_categories c\n           WHERE workspace_id = $1 AND deleted_at IS NULL\n             AND ($2::text IS NULL OR name ILIKE $2)\n             AND ($3::uuid IS NULL OR parent_id = $3)\n             AND ($3::uuid IS NOT NULL OR NOT $4 OR parent_id IS NULL)\n           ORDER BY id LIMIT $5 OFFSET $6",
