{
  "db_name": "PostgreSQL",
  "query": "SELECT l.id, l.from_workspace_id, l.to_workspace_id, w.id AS partner_id,\n                w.name AS partner_name,\n                coalesce(nullif(btrim(w.profile->>'company_name'), ''), w.name)\n                    AS \"partner_display_name!\",\n                l.fields, l.granted_at, l.accepted_at, l.revoked_at\n         FROM supply_links l\n         JOIN workspaces w ON w.id = CASE WHEN l.from_workspace_id = $1\n                                          THEN l.to_workspace_id ELSE l.from_workspace_id END\n         WHERE (l.from_workspace_id = $1 OR l.to_workspace_id = $1)\n           AND ($2::uuid IS NULL OR l.id = $2)\n           AND ($5::text IS NULL OR $5 = CASE WHEN l.revoked_at IS NOT NULL THEN 'revoked'\n                                             WHEN l.accepted_at IS NOT NULL THEN 'live'\n                                             ELSE 'pending' END)\n           AND ($6::text IS NULL OR ($6 = 'outgoing') = (l.from_workspace_id = $1))\n         ORDER BY l.granted_at DESC, l.id DESC LIMIT $3 OFFSET $4",
