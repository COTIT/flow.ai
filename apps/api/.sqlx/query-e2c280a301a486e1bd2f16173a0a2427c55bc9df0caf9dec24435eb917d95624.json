  "query": "SELECT id, name, description, logo, website, meta, created_at, updated_at,\n                  count(*) OVER () AS \"total!\"\n           FROM product_brands\n           WHERE workspace_id = $1 AND deleted_at IS NULL AND ($2::text IS NULL OR name ILIKE $2)\n           ORDER BY id LIMIT $3 OFFSET $4",
