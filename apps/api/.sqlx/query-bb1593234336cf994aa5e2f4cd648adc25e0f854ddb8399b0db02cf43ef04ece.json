  "query": "SELECT id, parent_id, name, description, meta, created_at, updated_at, (SELECT count(*) FROM products p\n              WHERE p.workspace_id = c.workspace_id AND p.category_id = c.id\n                AND p.deleted_at IS NULL) AS \"products_count!\" FROM product_categories c\n         WHERE workspace_id = $1 AND parent_id = $2 AND deleted_at IS NULL\n         ORDER BY id",
