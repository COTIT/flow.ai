  "query": "SELECT l.page_id,l.revision_id,l.expires_at FROM storefront_preview_links l JOIN storefront_pages p ON p.workspace_id=l.workspace_id AND p.id=l.page_id WHERE l.token_hash=$2 AND l.workspace_id=$1 AND l.revoked_at IS NULL AND l.expires_at>now() AND p.draft_revision_id=l.revision_id AND p.published_revision_id IS DISTINCT FROM l.revision_id",
