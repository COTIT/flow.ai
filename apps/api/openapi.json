{
  "components": {
    "schemas": {
      "CreateCurrencyRequest": {
        "description": "New currency. `asset_type` is an ISO 4217 code.",
        "properties": {
          "active": {
            "type": "boolean"
          },
          "asset_type": {
            "description": "ISO 4217 code, any case.",
            "example": "EUR",
            "type": "string"
          },
          "decimals": {
            "format": "int32",
            "maximum": 8,
            "minimum": 0,
            "type": "integer"
          },
          "default_currency": {
            "type": "boolean"
          },
          "meta": {
            "type": [
              "object",
              "null"
            ]
          },
          "name": {
            "maxLength": 255,
            "type": "string"
          },
          "symbol_prefix": {
            "maxLength": 10,
            "type": [
              "string",
              "null"
            ]
          },
          "symbol_suffix": {
            "maxLength": 10,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "asset_type",
          "decimals",
          "default_currency",
          "active"
        ],
        "type": "object"
      },
      "CurrencyCreated": {
        "description": "Create response: the new row's id.",
        "properties": {
          "currency_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "currency_id"
        ],
        "type": "object"
      },
      "CurrencyResource": {
        "description": "A currency the workspace can price in. Exactly one is the default.",
        "properties": {
          "active": {
            "type": "boolean"
          },
          "asset_type": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "decimals": {
            "format": "int32",
            "type": "integer"
          },
          "default_currency": {
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "last_updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "meta": {
            "type": [
              "object",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "symbol_prefix": {
            "type": [
              "string",
              "null"
            ]
          },
          "symbol_suffix": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "asset_type",
          "symbol_prefix",
          "symbol_suffix",
          "decimals",
          "default_currency",
          "active",
          "meta",
          "created_at",
          "last_updated_at"
        ],
        "type": "object"
      },
      "Envelope_CurrencyCreated": {
        "description": "Success body: the result under `data`.",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CurrencyCreated"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "Envelope_CurrencyResource": {
        "description": "Success body: the result under `data`.",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CurrencyResource"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "MessageBody": {
        "description": "A short message: `ok` after an action, or what went wrong.",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "Meta": {
        "description": "Paging details. `total` counts matches across all pages.",
        "properties": {
          "current_page": {
            "format": "int64",
            "type": "integer"
          },
          "from": {
            "description": "1-based index of first row on this page; null when the page is empty.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "last_page": {
            "format": "int64",
            "type": "integer"
          },
          "per_page": {
            "format": "int64",
            "type": "integer"
          },
          "to": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "current_page",
          "from",
          "last_page",
          "per_page",
          "to",
          "total"
        ],
        "type": "object"
      },
      "Paginated_CurrencyResource": {
        "description": "One page of results plus paging details.",
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/CurrencyResource"
            },
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "type": "object"
      },
      "UpdateCurrencyRequest": {
        "description": "Changes to a currency. Leave a field out to keep it; send null to clear it.",
        "properties": {
          "active": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "asset_type": {
            "example": "EUR",
            "type": [
              "string",
              "null"
            ]
          },
          "decimals": {
            "format": "int32",
            "maximum": 8,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "default_currency": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "meta": {
            "type": [
              "object",
              "null"
            ]
          },
          "name": {
            "maxLength": 255,
            "type": [
              "string",
              "null"
            ]
          },
          "symbol_prefix": {
            "maxLength": 10,
            "type": [
              "string",
              "null"
            ]
          },
          "symbol_suffix": {
            "maxLength": 10,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "ValidationErrorBody": {
        "description": "Validation failed. `errors` maps each field to its messages.",
        "properties": {
          "errors": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message",
          "errors"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "One backend for the Genesy shop, office, field and till apps. Every private route needs `Authorization: Bearer <token>`.",
    "license": {
      "name": "Proprietary"
    },
    "title": "Genesy API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/workspace/{workspace}/currencies": {
      "get": {
        "operationId": "currencies_list",
        "parameters": [
          {
            "description": "Workspace id",
            "in": "path",
            "name": "workspace",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Search on name and asset type.",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "1-based; junk falls back to 1.",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "Default 50, max 100.",
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Paginated_CurrencyResource"
                }
              }
            },
            "description": "One page of currencies"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageBody"
                }
              }
            },
            "description": "Membership is inactive"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageBody"
                }
              }
            },
            "description": "Unknown workspace, or caller not a member"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List currencies",
        "tags": [
          "currencies"
        ]
      },
      "post": {
        "operationId": "currencies_create",
        "parameters": [
          {
            "description": "Workspace id",
            "in": "path",
            "name": "workspace",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCurrencyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_CurrencyCreated"
                }
              }
            },
            "description": "Created; returns the new id"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageBody"
                }
              }
            },
            "description": "Inactive membership or missing `currency.create`"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageBody"
                }
              }
            },
            "description": "Unknown workspace, or caller not a member"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorBody"
                }
              }
            },
            "description": "Invalid input"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create a currency",
        "tags": [
          "currencies"
        ]
      }
    },
    "/workspace/{workspace}/currencies/{currency}": {
      "delete": {
        "operationId": "currencies_delete",
        "parameters": [
          {
            "description": "Workspace id",
            "in": "path",
            "name": "workspace",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Currency id",
            "in": "path",
            "name": "currency",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageBody"
                }
              }
            },
            "description": "Done (`ok`)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageBody"
                }
              }
            },
            "description": "Inactive membership or missing `currency.delete`"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageBody"
                }
              }
            },
            "description": "Unknown workspace or currency, or caller not a member"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Delete a currency",
        "tags": [
          "currencies"
        ]
      },
      "get": {
        "operationId": "currencies_get",
        "parameters": [
          {
            "description": "Workspace id",
            "in": "path",
            "name": "workspace",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Currency id",
            "in": "path",
            "name": "currency",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_CurrencyResource"
                }
              }
            },
            "description": "The currency"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageBody"
                }
              }
            },
            "description": "Membership is inactive"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageBody"
                }
              }
            },
            "description": "Unknown workspace or currency, or caller not a member"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get a currency",
        "tags": [
          "currencies"
        ]
      },
      "post": {
        "operationId": "currencies_update",
        "parameters": [
          {
            "description": "Workspace id",
            "in": "path",
            "name": "workspace",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Currency id",
            "in": "path",
            "name": "currency",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCurrencyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageBody"
                }
              }
            },
            "description": "Done (`ok`)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageBody"
                }
              }
            },
            "description": "Not logged in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageBody"
                }
              }
            },
            "description": "Inactive membership or missing `currency.update`"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageBody"
                }
              }
            },
            "description": "Unknown workspace or currency, or caller not a member"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorBody"
                }
              }
            },
            "description": "Invalid input"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Update a currency (send only changed fields)",
        "tags": [
          "currencies"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/v1"
    }
  ]
}
