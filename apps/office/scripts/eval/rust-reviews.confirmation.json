    {
      "id": "capability-secure-key-create-refusal",
      "test": "assistant_capability_auth::every_effectful_capability_refuses_its_exact_unapproved_action",
      "operations": [
        "app_keys_create"
      ],
      "gates": {
        "confirmation": [
          422
        ]
      },
      "assertions": [
        {
          "file": "apps/api/tests/api/assistant_capability_auth.rs",
          "contains": "if case.id == \"app_keys_create\""
        },
        {
          "file": "apps/api/tests/api/assistant_capability_auth.rs",
          "contains": "\"errors\":{\"operation_id\":[\"Use the secure Office form for this action.\"]}"
        },
        {
          "file": "apps/api/tests/api/assistant_capability_auth.rs",
          "contains": "(\"proposed\".into(), true, true, true, true)"
        }
      ],
      "review": "Only app_keys_create is a secure-UI refusal: exact422 message and operation_id error, with proposed state and NULL approval/dispatch/result/finish metadata unchanged. All other217 operations, including key revocation, require exact409 approval refusal. No generic422 accepted. No secure key creation, approved revocation, UI handoff or result evidence implied. Entire fresh case and observed operation422 required."
    }
