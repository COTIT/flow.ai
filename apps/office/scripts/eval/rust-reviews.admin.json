{
  "version": 1,
  "reviews": [
    {
      "id": "admin-team-route-authority",
      "test": "teams::each_route_needs_its_permission",
      "operations": [
        "teams_create",
        "teams_list",
        "teams_get",
        "teams_update",
        "teams_delete",
        "teams_add_users",
        "teams_remove_users",
        "teams_set_permissions"
      ],
      "gates": {
        "authorization": [403],
        "restricted_role": [403]
      },
      "assertions": [
        {
          "file": "apps/api/tests/api/teams.rs",
          "contains": "\"{method} {path} without {perm}\""
        }
      ],
      "review": "Each native route is called by an active member without grants and must return403 with exact unauthorized message; another member holding that route permission succeeds. Success alone is not a result assertion."
    },
    {
      "id": "admin-team-hidden",
      "test": "teams::deleted_and_foreign_teams_are_hidden",
      "operations": [
        "teams_get",
        "teams_update",
        "teams_delete",
        "teams_add_users",
        "teams_set_permissions"
      ],
      "gates": {
        "cross_workspace": [404],
        "validation": [404]
      },
      "assertions": [
        {
          "file": "apps/api/tests/api/teams.rs",
          "contains": "assert_eq!(status, StatusCode::NOT_FOUND, \"{method} {path}: {res}\");"
        }
      ],
      "review": "Actual foreign team, deleted team and malformed identifier all return404 through GET/update/delete/add-users/permissions. Collection create and remove-users excluded."
    },
    {
      "id": "admin-team-list-outsider",
      "test": "teams::outsider_gets_404",
      "operations": ["teams_list"],
      "gates": {
        "cross_workspace": [404]
      },
      "assertions": [
        {
          "file": "apps/api/tests/api/teams.rs",
          "contains": "let (status, _) = w.call(Method::GET, \"\", None, &eve).await;"
        }
      ],
      "review": "A real second workspace owner cannot list first workspace teams."
    },
    {
      "id": "admin-team-create-state",
      "test": "teams::create_then_get_in_team_resource_shape",
      "operations": ["teams_create", "teams_get"],
      "gates": {
        "result": [200, 201]
      },
      "assertions": [
        {
          "file": "apps/api/tests/api/teams.rs",
          "contains": "team[\"permissions\"],\n        json!([\"relation.create\", \"relation.get\", \"workspace_admin\"])"
        }
      ],
      "review": "Create receipt asserts exactly known applied permissions and two ignored values; independent GET verifies id/name/meta/lowercase grants. Receipt addition has observed RED; execution proof requires later passing run."
    },
    {
      "id": "admin-team-delta-state",
      "test": "teams::permissions_save_is_a_delta",
      "operations": ["teams_set_permissions"],
      "gates": {
        "result": [200],
        "validation": [422]
      },
      "assertions": [
        {
          "file": "apps/api/tests/api/teams.rs",
          "contains": "\"status\":\"partial\", \"applied\":[\"-order.list\"], \"not_applied\":[\"order.list\"], \"ignored_count\":0"
        }
      ],
      "review": "GET verifies persisted deltas; receipt distinguishes removal-wins conflict, unknown/nonstring inputs and empty delta. Missing permissions is422 with exact field message. Requires passing post-fix run."
    },
    {
      "id": "admin-team-owner-only",
      "test": "teams::only_owner_grants_workspace_admin",
      "operations": ["teams_set_permissions"],
      "gates": {
        "result": [200]
      },
      "assertions": [
        {
          "file": "apps/api/tests/api/teams.rs",
          "contains": "\"not_applied\":[\"workspace_admin\"]"
        }
      ],
      "review": "Nonowner team.permissions actor gets200 partial with requested admin not applied; independent owner GET proves only relation.list persisted, then owner grant succeeds. This is semantic refusal inside successful native HTTP status, not a403 authorization gate."
    },
    {
      "id": "admin-team-private-receipt",
      "test": "teams::create_receipt_reports_restricted_permissions_without_disclosing_other_grants",
      "operations": ["teams_create", "teams_set_permissions"],
      "gates": {
        "result": [200, 201]
      },
      "assertions": [
        {
          "file": "apps/api/tests/api/teams.rs",
          "contains": "assert!(!response.to_string().contains(\"order.list\"));"
        }
      ],
      "review": "Write-only team actor cannot receive unrelated grants or raw unknown input. Restricted create and delta receipts assert exact safe requested subsets; independent owner GET proves stored grants. Requires passing post-fix run."
    },
