{
  "name": "@genesy/office",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node ../../packages/voice/scripts/prepare-voice-audio.mjs public && next dev --port 3001",
    "build": "node ../../packages/voice/scripts/prepare-voice-audio.mjs public && next build",
    "start": "next start --port 3001",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "voice:generate": "node scripts/generate-voice-catalog.mjs",
    "voice:check": "node scripts/generate-voice-catalog.mjs --check",
    "voice:triage": "node scripts/voice-heal.mjs triage",
    "voice:heal": "node scripts/voice-heal.mjs heal",
    "voice:demand": "node scripts/voice-heal.mjs demand"
  },
  "dependencies": {
    "@alexanderolsen/libsamplerate-js": "2.1.2",
    "@elevenlabs/client": "1.35.0",
    "@genesy/api-client": "workspace:^",
    "@genesy/i18n": "workspace:*",
    "@genesy/security": "workspace:*",
    "@genesy/ui": "workspace:*",
    "@genesy/voice": "workspace:*",
    "@langchain/langgraph": "^1.7.1",
    "@langchain/langgraph-checkpoint-postgres": "1.1.2",
    "@tanstack/react-query": "^5.105.0",
    "ajv": "8",
    "ajv-formats": "3",
    "fflate": "0.8.2",
    "langsmith": "^0.11.8",
    "lucide-react": "^1.65.0",
    "motion": "12.43.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "next-themes": "^0.4.6",
    "pg": "8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@genesy/eslint-config": "workspace:*",
    "@genesy/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
