# Copy to .env.local
# Backend address for server code and the /v1 forward (the browser always calls /v1).
API_URL=http://localhost:8080/v1
# Public shop address, for the batch page link in the passport editor (optional).
NEXT_PUBLIC_SHOP_URL=http://localhost:3000
# File storage host for signed image links (product images, passport preview); one exact origin.
FILES_ORIGIN=

# Voice assistant (server only; rotate these by replacing the local values and restarting).
ASSISTANT_ENABLED=false
# Comma-separated workspace UUIDs; required before enabling new assistant work.
ASSISTANT_WORKSPACE_ALLOWLIST=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Same random secret (at least 32 characters) on Office and Rust API.
ASSISTANT_BRIDGE_SECRET=
# Restricted assistant_checkpoint_local/staging/production role; never the business DB user.
ASSISTANT_CHECKPOINT_URL=
# Runtime secrets may use NAME_FILE instead of NAME; never set both.
# ELEVENLABS_API_KEY_FILE=/run/secrets/elevenlabs_api_key
# ASSISTANT_BRIDGE_SECRET_FILE=/run/secrets/assistant_bridge_secret
# ASSISTANT_CHECKPOINT_URL_FILE=/run/secrets/assistant_checkpoint_url
# LANGSMITH_API_KEY_FILE=/run/secrets/langsmith_api_key
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=genesy-office-voice
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGCHAIN_CALLBACKS_BACKGROUND=false
