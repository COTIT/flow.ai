{
  "extends": "@genesy/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@genesy/ui/*": ["../../packages/ui/src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // shortcut: e2e is type-checked by Playwright, not tsc, until @genesy/e2e brings @playwright/test; then drop these two.
  "exclude": ["node_modules", "e2e", "playwright.config.ts"]
}
