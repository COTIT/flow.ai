  "query": "SELECT id, location, meta, created_at, updated_at, count(*) OVER () AS \"total!\"\n           FROM warehouse_locations\n           WHERE workspace_id = $1 AND warehouse_id = $2 AND deleted_at IS NULL\n             AND ($3::text IS NULL OR location ILIKE $3)\n           ORDER BY id\n           LIMIT $4 OFFSET $5",
