  "query": "SELECT i.id, i.workspace_id, w.name AS workspace_name, i.email, i.status,\n                i.expires_at, i.created_at\n         FROM invites i\n         JOIN workspaces w ON w.id = i.workspace_id AND w.deleted_at IS NULL\n         WHERE i.token_hash = $1",
