  "db_name": "PostgreSQL",
  "query": "SELECT id, name, vat_amount, default_group, country, meta, created_at, updated_at,\n                  count(*) OVER () AS \"total!\"\n           FROM vat_groups\n           WHERE workspace_id = $1 AND deleted_at IS NULL\n             AND ($2::text IS NULL OR country = $2)\n             AND ($3::text IS NULL OR name ILIKE $3)\n           ORDER BY id\n           LIMIT $4 OFFSET $5",
