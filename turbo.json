{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "ELEVENLABS_API_KEY",
    "ELEVENLABS_API_KEY_FILE",
    "ELEVENLABS_AGENT_ID",
    "GENESY_ASSISTANT_NATIVE_AGENT_ID",
    "ASSISTANT_NATIVE_IMAGE_ID",
    "ASSISTANT_ENABLED",
    "ASSISTANT_WORKSPACE_ALLOWLIST",
    "ASSISTANT_ENABLED_FILE",
    "ASSISTANT_BRIDGE_SECRET",
    "ASSISTANT_BRIDGE_SECRET_FILE",
    "ASSISTANT_CHECKPOINT_URL",
    "ASSISTANT_CHECKPOINT_URL_FILE",
    "LANGSMITH_API_KEY",
    "LANGSMITH_API_KEY_FILE",
    "LANGSMITH_TRACING",
    "LANGCHAIN_TRACING",
    "LANGCHAIN_TRACING_V2",
    "LANGSMITH_PROJECT",
    "LANGSMITH_HIDE_INPUTS",
    "LANGSMITH_HIDE_OUTPUTS",
    "LANGCHAIN_CALLBACKS_BACKGROUND",
    "VOICE_UPSTREAM_URL",
    "OFFICE_PUBLIC_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "NEXT_PUBLIC_*",
        "VITE_*",
        "API_URL",
        "SITE_URL",
        "STOREFRONT_APP_KEY",
        "FILES_ORIGIN",
        "FLOW_URL",
        "NEXT_OUTPUT",
        "NEXT_DIST_DIR",
        "NOINDEX",
        "NODE_ENV"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "e2e": {
      "dependsOn": [
        "@genesy/shop#build",
        "@genesy/office#build",
        "@genesy/field#build",
        "@genesy/till#build",
        "@genesy/landing#build",
        "@genesy/flow#build"
      ],
      "passThroughEnv": [
        "CI",
        "HOME",
        "PLAYWRIGHT_BROWSERS_PATH",
        "E2E_PORT_OFFSET",
        "E2E_STACK_OFFSET",
        "E2E_DESIGN",
        "SHOP_DESIGN_ENABLED",
        "FLOW_URL"
      ],
      "cache": false
    },
    "openapi": {
      "outputs": ["openapi.json"]
    },
    "generate": {
      "dependsOn": ["@genesy/api#openapi"],
      "inputs": [
        "orval.config.ts",
        "src/mutator.ts",
        "$TURBO_ROOT$/apps/api/openapi.json"
      ],
      "outputs": ["src/generated/**"]
    },
    "generate:check": {
      "dependsOn": ["@genesy/api#openapi"],
      "cache": false
    }
  }
}
