{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "NEXT_PUBLIC_*",
        "API_URL",
        "SITE_URL",
        "STOREFRONT_APP_KEY",
        "FILES_ORIGIN"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "openapi": {
      "outputs": ["openapi.json"]
    },
    "generate": {
      "dependsOn": ["@genesy/api#openapi"],
      "inputs": [
        "orval.config.ts",
        "src/mutator.ts",
        "$TURBO_ROOT$/apps/api/openapi.json"
      ],
      "outputs": ["src/generated/**"]
    },
    "generate:check": {
      "dependsOn": ["@genesy/api#openapi"],
      "cache": false
    }
  }
}
