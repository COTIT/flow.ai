{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "NEXT_PUBLIC_*",
        "VITE_*",
        "API_URL",
        "SITE_URL",
        "STOREFRONT_APP_KEY",
        "FILES_ORIGIN",
        "NEXT_OUTPUT",
        "NEXT_DIST_DIR",
        "NOINDEX",
        "NODE_ENV"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "e2e": {
      "dependsOn": [
        "@genesy/shop#build",
        "@genesy/office#build",
        "@genesy/field#build",
        "@genesy/till#build",
        "@genesy/landing#build"
      ],
      "passThroughEnv": [
        "CI",
        "HOME",
        "PLAYWRIGHT_BROWSERS_PATH",
        "E2E_PORT_OFFSET"
      ],
      "cache": false
    },
    "openapi": {
      "outputs": ["openapi.json"]
    },
    "generate": {
      "dependsOn": ["@genesy/api#openapi"],
      "inputs": [
        "orval.config.ts",
        "src/mutator.ts",
        "$TURBO_ROOT$/apps/api/openapi.json"
      ],
      "outputs": ["src/generated/**"]
    },
    "generate:check": {
      "dependsOn": ["@genesy/api#openapi"],
      "cache": false
    }
  }
}
